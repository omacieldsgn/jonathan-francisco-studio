// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

model Business {
  id           String   @id
  name         String
  slug         String   @unique
  phone        String
  whatsapp     String
  email        String
  instagramUrl String
  address      String
  timezone     String
  logoUrl      String?
  coverUrl     String?
  status       String
}

model UserProfile {
  id        String   @id
  role      String
  fullName  String
  phone     String
  email     String   @unique
  avatarUrl String?
  status    String
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
}

model Professional {
  id           String   @id
  name         String
  bio          String
  avatarUrl    String
  specialties  String // JSON stringified array
  active       Boolean
  displayOrder Int
  services     ProfessionalService[]
  hours        ProfessionalHour[]
  appointments Appointment[]
}

model ServiceCategory {
  id           String    @id
  name         String
  slug         String    @unique
  displayOrder Int
  active       Boolean
  services     Service[]
}

model Service {
  id                    String   @id
  categoryId            String
  category              ServiceCategory @relation(fields: [categoryId], references: [id])
  name                  String
  slug                  String   @unique
  shortDescription      String
  description           String
  imageUrl              String?
  durationMinutes       Int
  bufferBeforeMinutes   Int
  bufferAfterMinutes    Int
  priceCents            Int
  promotionalPriceCents Int?
  onlineBookingEnabled  Boolean
  active                Boolean
  displayOrder          Int
  professionals         ProfessionalService[]
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

model BusinessHour {
  id       String  @id @default(uuid())
  weekday  Int
  opensAt  String
  closesAt String
  active   Boolean
}

model ProfessionalHour {
  id             String   @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  startsAt       String
  endsAt         String
  active         Boolean
}

model ScheduleException {
  id             String   @id
  professionalId String?
  startsAt       String
  endsAt         String
  type           String
  reason         String
}

model Appointment {
  id                 String   @id
  shortCode          String   @unique
  customerId         String
  customerName       String
  customerPhone      String
  customerEmail      String?
  professionalId     String
  professional       Professional @relation(fields: [professionalId], references: [id])
  professionalName   String
  startsAt           String
  endsAt             String
  status             String
  subtotalCents      Int
  discountCents      Int
  totalCents         Int
  paymentMethod      String
  paymentStatus      String
  customerNote       String?
  internalNote       String?
  source             String
  cancellationReason String?
  cancelledAt        String?
  createdAt          String
  updatedAt          String
  items              AppointmentItem[]
}

model AppointmentItem {
  id                      String   @id
  appointmentId           String
  appointment             Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId               String
  serviceNameSnapshot     String
  durationMinutesSnapshot Int
  unitPriceCentsSnapshot  Int
}

model WaitlistEntry {
  id                 String   @id
  customerId         String
  customerName       String
  customerPhone      String
  professionalId     String?
  preferredDateStart String
  preferredDateEnd   String
  preferredPeriods   String // JSON stringified array
  serviceIds         String // JSON stringified array
  status             String
  expiresAt          String?
  createdAt          String
}

model Coupon {
  id            String   @id
  code          String   @unique
  discountType  String
  discountValue Int
  startsAt      String
  endsAt        String
  maxUses       Int
  currentUses   Int
  minTotalCents Int
  active        Boolean
}

model Review {
  id             String   @id
  appointmentId  String
  customerId     String
  customerName   String
  professionalId String
  rating         Int
  comment        String
  status         String
  createdAt      String
}
